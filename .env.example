# Set a reviewed deployment origin before staging or production.
SITE_URL=
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=2024-05-12
SANITY_USE_CDN=true

# Local checked-in draft only; never use it as CMS readback evidence.
PUBLIC_EASYPM_LOCAL_PREVIEW=false

# Both flags stay false until service-scope and launch approvals are recorded.
EASYPM_INCLUDE_PENDING_SERVICES=false
EASYPM_ALLOW_INDEXING=false

# Keep real credentials and delivery URLs in an ignored .env.local file.
SANITY_API_TOKEN=
AUTOMATION_WEBHOOK_URL=
SANITY_WEBHOOK_SECRET=
