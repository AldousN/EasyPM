---
export const prerender = false;
import MainLayout from "../../components/layouts/MainLayout.astro";
import { getSanityClient } from "../../lib/sanityClient";
import { portableTextToHtml } from "../../lib/portableText";
import { optimizeImageUrl } from "../../lib/imageOptimizer";

interface Props {
  slug: string;
}

const { slug: slugProp } = Astro.props as Props;
const { slug: slugParam } = Astro.params;
const slug = slugProp || slugParam;

// Fetch full post data for the requested slug
const sanityClient = getSanityClient();
if (!sanityClient) {
  return new Response("Not Found", { status: 404 });
}

const post = await sanityClient.fetch(
  `
  *[_type == 'blogPost' && slug.current == $slug][0]{
    title,
    slug,
    excerpt,
    publishedAt,
    featuredImage {
      asset -> {
        url,
        metadata {
          dimensions {
            width,
            height
          }
        }
      },
      alt
    },
    author,
    "categories": categories[]->name,
    "categorySlugs": categories[]->slug.current,
    "tags": tags[]->name,
    content,
    seo {
      metaTitle,
      metaDescription,
      canonicalUrl
    }
  }
`,
  { slug },
);

if (!post) {
  return new Response("Not Found", { status: 404 });
}

const htmlContent = post.content ? portableTextToHtml(post.content, false) : "";
const shareUrl = post.seo?.canonicalUrl || Astro.url.href;
const encodedShareUrl = encodeURIComponent(shareUrl);
const featuredImageUrl = post.featuredImage?.asset?.url;
const featuredImageAlt = post.featuredImage?.alt || post.title;
const featuredImage = featuredImageUrl
  ? {
      src: optimizeImageUrl(featuredImageUrl, {
        width: 1200,
        height: 600,
        fit: "crop",
        quality: 82,
      }),
      srcset: [
        `${optimizeImageUrl(featuredImageUrl, { width: 600, height: 300, fit: "crop", quality: 78 })} 600w`,
        `${optimizeImageUrl(featuredImageUrl, { width: 1000, height: 500, fit: "crop", quality: 80 })} 1000w`,
        `${optimizeImageUrl(featuredImageUrl, { width: 1200, height: 600, fit: "crop", quality: 82 })} 1200w`,
      ].join(", "),
      sizes: "(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1200px",
    }
  : null;
---

<MainLayout
  pageTitle={post.title}
  description={post.excerpt || post.seo?.metaDescription}
  canonicalUrl={post.seo?.canonicalUrl}
>
  <article class="w-full bg-white section-padding">
    <div class="article-container">
      {/* Featured Image */}
      {
        featuredImage && (
          <div class="mb-8 overflow-hidden rounded-2xl">
            <img
              src={featuredImage.src}
              srcset={featuredImage.srcset}
              sizes={featuredImage.sizes}
              alt={featuredImageAlt}
              width={1000}
              height={500}
              class="aspect-[2/1] w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }

      {/* Meta Information */}
      <div
        class="mb-8 flex flex-wrap items-center gap-4 border-b border-slate-200 pb-6"
      >
        {
          post.categories?.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.categories.map((category: string) => (
                <span class="article-category">
                  {category}
                </span>
              ))}
            </div>
          )
        }
        {
          post.publishedAt && (
            <span class="text-sm text-slate-600">
              {new Date(post.publishedAt).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </span>
          )
        }
        {
          post.author && (
            <span class="text-sm text-slate-600">By {post.author}</span>
          )
        }
      </div>

      {/* Title */}
      <h1 class="mb-6 text-5xl font-bold text-slate-900">{post.title}</h1>

      {/* Excerpt */}
      {
        post.excerpt && (
          <p class="mb-8 text-xl text-slate-700">{post.excerpt}</p>
        )
      }

      {/* Content */}
      {
        htmlContent && (
          <div class="article-prose prose prose-purple max-w-3xl mx-auto mb-12 space-y-4">
            <Fragment set:html={htmlContent} />
          </div>
        )
      }

      <nav class="article-share" aria-label="Share this article">
        <span>Share This Article</span>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`} target="_blank" rel="noopener noreferrer">Facebook<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedShareUrl}`} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${encodedShareUrl}`}>Email</a>
      </nav>

      {/* Tags */}
      {
        post.tags && post.tags.length > 0 && (
          <div class="mt-12 border-t border-slate-200 pt-8">
            <div class="flex flex-wrap gap-3">
              {post.tags.map((tag: string) => (
                <span class="inline-block rounded-full bg-slate-100 px-4 py-2 text-sm text-slate-700">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )
      }

      {/* Back Link */}
      <div class="mt-12 border-t border-slate-200 pt-8">
        <a href="/blog/" class="btn-primary inline-flex"> ← Back to Blog </a>
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .article-container { width: min(calc(100% - 2 * var(--site-gutter)), 768px); margin-inline: auto; }
  .article-container h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.15; letter-spacing: -.025em; }
  .article-category { display: inline-block; padding: 6px 14px; border: 1px solid var(--purple-primary); border-radius: 999px; background: var(--purple-primary); color: var(--button-text); font-size: 13px; font-weight: 700; }
  .article-prose { color: #334155; font-size: 18px; line-height: 1.8; }
  .article-prose :global(h2), .article-prose :global(h3), .article-prose :global(h4) { color: #111827; line-height: 1.25; margin-top: 1.8em; margin-bottom: .65em; }
  .article-prose :global(a) { color: var(--purple-hover); text-decoration: underline; text-underline-offset: 3px; }
  .article-prose :global(p), .article-prose :global(ul), .article-prose :global(ol) { margin-bottom: 1.25em; }
  .article-prose :global(img) { max-width: 100%; height: auto; border-radius: 16px; }
  .article-share { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding-block: 24px; border-block: 1px solid #e2e8f0; }
  .article-share span:first-child { font-weight: 700; color: #111827; }
  .article-share a { min-height: 44px; display: inline-flex; align-items: center; padding: 9px 16px; border: 1px solid var(--purple-soft); border-radius: 999px; color: var(--purple-hover); font-size: 14px; font-weight: 700; }
  .article-share a:hover { background: var(--purple-soft); }
  .article-share a:focus-visible { outline: 3px solid var(--purple-primary); outline-offset: 3px; }
</style>
