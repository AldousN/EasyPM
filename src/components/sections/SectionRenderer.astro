---
import HeroSection from './HeroSection.astro';
import ServiceGridSection from './ServiceGridSection.astro';
import ImageCardSection from './ImageCardSection.astro';
import CtaSection from './CtaSection.astro';
import ContactSection from './ContactSection.astro';
import ServiceAreaSection from './ServiceAreaSection.astro';
import BlogListSection from './BlogListSection.astro';
import IconGridSection from './IconGridSection.astro';
import TwoColTextImageSection from './TwoColTextImageSection.astro';
import LeadFormSection from './LeadFormSection.astro';
import HtmlSection from './HtmlSection.astro';
import FaqSection from './FaqSection.astro';
import AreasSection from './AreasSection.astro';
import StepsSection from './StepsSection.astro';
import type { Sections } from '../../types/sections';

const { sections = [] } = Astro.props as { sections: Sections[] };

const componentMap = {
  heroSection: HeroSection,
  serviceGridSection: ServiceGridSection,
  processSection: ImageCardSection,
  ctaSection: CtaSection,
  contactSection: ContactSection,
  serviceAreaSection: ServiceAreaSection,
  blogListSection: BlogListSection,
  iconGridSection: IconGridSection,
  twoColTextImageSection: TwoColTextImageSection,
  leadFormSection: LeadFormSection,
  htmlSection: HtmlSection,
  faqSection: FaqSection,
  areasSection: AreasSection,
  stepsSection: StepsSection
} as const;

---

{sections.map((section) => {
  const Component = componentMap[section._type];
  if (!Component) {
    return null;
  }

  return (
    <Component {...section} />
  );
})} 
