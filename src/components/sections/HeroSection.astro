---
/**
 * HeroSection — v5-modern visual rebuild.
 *
 * Strategy: same Sanity content fields, completely rebuilt presentation.
 * Reference design: FFS v5-modern (styles-modern.css + components-1.jsx).
 *
 * Field mapping (Sanity → v5):
 *   subtitle           → .hero-meta chip (eyebrow)
 *   title + highlight  → <h1> with .leaf gradient on the highlighted word
 *   body               → .hero-byline (portable text, light theme)
 *   primaryCta*        → .btn-primary
 *   secondaryCta*      → .btn-ghost
 *   bullets            → .hero-trust strip
 *   sideImage          → .hero-side bento card (when present)
 *
 * Out of scope (intentionally not rendered in v5 hero — fields kept in Sanity
 * but ignored visually): coupon block, sideMapEmbed, layoutStyle/sideImageSize,
 * ctaSubtitle. They remain in the schema; we just don't render them here.
 */
import type { HeroSection } from "../../types/sections";
import { portableTextToHtml } from "../../lib/portableText";
import { splitHighlight } from "../../utils/highlightTitle";
import {
  buildSanityImageUrl,
  getFigmaCompactHeroBackgroundUrl,
  getFigmaHeroBackgroundUrl,
  getHeroBackgroundUrl,
  getHeroSideImageConfig,
  getHeroSideImageSrcSet,
  getHeroSideImageUrl,
} from "../../lib/imageOptimizer";
import { normalizeInternalHref } from "../../lib/links";
import { EASYPM_FALLBACK_VIDEO_URL, getYouTubeEmbedUrl } from '../../lib/youtube';

const props = Astro.props as HeroSection;
// Keep the rendered background in sync with the optimized URL used by the
// page-level preload. Sanity sources are served as appropriately sized WebP;
// local preview assets already point to their optimized WebP files.
const backgroundImageUrl = props.backgroundImage
  ? props.visualVariant === 'figmaHeader'
    ? props.bannerSize === 'compact'
      ? getFigmaCompactHeroBackgroundUrl(props.backgroundImage)
      : getFigmaHeroBackgroundUrl(props.backgroundImage)
    : getHeroBackgroundUrl(props.backgroundImage)
  : '';
const primaryCtaHref = normalizeInternalHref(props.primaryCtaLink);
const secondaryCtaHref = normalizeInternalHref(props.secondaryCtaLink);
// Light theme — render body as ink, not inverted
const bodyHtml = props.body && props.body.length > 0
  ? portableTextToHtml(props.body, false)
  : "";
const figmaBodyHtml = props.body && props.body.length > 0
  ? portableTextToHtml(props.body, true)
  : '';
const titleSegments = props.title
  ? splitHighlight(props.title, props.highlightText)
  : [];
const hasBullets = Boolean(props.bullets?.length);

/**
 * Layout decision honors the Sanity `layoutStyle` radio (oneColumn vs
 * twoColumn) explicitly, so content authors get predictable behavior:
 *   - twoColumn + sideImage set     → bento card on the right (text left)
 *   - twoColumn + no sideImage      → single-column fallback (no empty bento)
 *   - oneColumn (or default)        → centered single column;
 *                                     sideImage (if uploaded) renders as
 *                                     the central image stage with badges
 *
 * This means: to have NO image at all, choose "One Column" AND clear the
 * image. To have a right-column image, choose "Two Column".
 */
const sideImageConfig = getHeroSideImageConfig(props.sideImageSize);
const sideImageSize = sideImageConfig.size;
const sideImageSizes = sideImageConfig.sizes;
const sideImageUrl = getHeroSideImageUrl(props.sideImage, props.sideImageSize);
const sideImageSrcSet = getHeroSideImageSrcSet(
  props.sideImage,
  props.sideImageSize,
);
const wantsTwoColumn = props.layoutStyle === 'twoColumn';
const hasSideImage = Boolean(props.sideImage?.url);
const hasSide = wantsTwoColumn && hasSideImage;

/**
 * Single-column hero image stage uses a 21:9 aspect ratio.
 * Build a Sanity URL at that exact aspect (with fit: 'crop') so
 * Sanity's crop + hotspot metadata is what drives the framing —
 * NOT a downstream CSS object-fit: cover center-crop.
 *
 * Square getHeroSideImageUrl() is fine for the bento side card,
 * but in the single-col stage it generates a square that CSS then
 * recrops to 21:9 ignoring hotspot.
 */
const heroStageWidths: Array<{ w: number; h: number }> = [
  { w: 480, h: 206 },     // 21:9 mobile
  { w: 768, h: 329 },
  { w: 1100, h: 471 },
  { w: 1600, h: 686 },
];
const heroStageImageUrl = hasSideImage && props.sideImage
  ? buildSanityImageUrl(props.sideImage, {
      width: 1100,
      height: 471,
      quality: 78,
      format: 'webp',
      fit: 'crop',
    })
  : '';
const heroStageSrcSet = hasSideImage && props.sideImage
  ? heroStageWidths
      .map(({ w, h }) => {
        const url = buildSanityImageUrl(props.sideImage, {
          width: w,
          height: h,
          quality: w <= 768 ? 70 : 78,
          format: 'webp',
          fit: 'crop',
        });
        return `${url} ${w}w`;
      })
      .join(', ')
  : '';

// Sanity-driven frame choice for the right column. Defaults to 'bordered'
// — clean image with a thin red brand border, no labels, no inner padding.
const sideFrame = ((props as any).sideImageFrame as 'card' | 'bordered' | 'plain' | undefined) ?? 'bordered';
const figmaSideContain = props.sideImageFit === 'contain';
const figmaVideoImage = props.sideImage
  ? buildSanityImageUrl(props.sideImage, { width: 1604, height: figmaSideContain ? undefined : 1026, quality: 82, format: 'webp', fit: figmaSideContain ? 'max' : 'crop' })
  : '';
const figmaVideoSrcSet = props.sideImage?.asset?._ref
  ? [480, 802, 1604].map((width) => `${buildSanityImageUrl(props.sideImage!, {
      width, height: figmaSideContain ? undefined : Math.round(width * 513 / 802), quality: 80, format: 'webp', fit: figmaSideContain ? 'max' : 'crop'
    })} ${width}w`).join(', ')
  : undefined;
const figmaVideoEmbedUrl = props.mediaType === 'image'
  ? null
  : getYouTubeEmbedUrl(props.videoUrl) ?? (
      props.mediaType === 'video' ? getYouTubeEmbedUrl(EASYPM_FALLBACK_VIDEO_URL) : null
    );
const hasFigmaMedia = Boolean(figmaVideoEmbedUrl || figmaVideoImage);
---

{props.visualVariant === 'figmaHeader' ? (
  <section class={`figma-hero ${hasFigmaMedia || props.layoutStyle === 'twoColumn' ? '' : 'figma-hero--solo'} ${props.bannerSize === 'compact' ? 'figma-hero--compact' : ''}`} style={backgroundImageUrl ? `--figma-hero-background:url("${backgroundImageUrl}")` : undefined}>
    <div class="figma-hero-inner grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="figma-hero-copy">
        {props.subtitle && <p class="figma-hero-eyebrow">{props.subtitle}</p>}
        {titleSegments.length > 0 && (
          <h1>{titleSegments.map((segment) => segment.highlight ? <span class="figma-hero-accent">{segment.text}</span> : <span>{segment.text}</span>)}</h1>
        )}
        {figmaBodyHtml && <div class="figma-hero-body" set:html={figmaBodyHtml} />}
        <div class="figma-hero-actions">
          {props.primaryCtaLabel && primaryCtaHref && <a class="figma-hero-primary" href={primaryCtaHref}>{props.primaryCtaLabel}</a>}
          {props.secondaryCtaLabel && secondaryCtaHref && <a class="figma-hero-secondary" href={secondaryCtaHref}>{props.secondaryCtaLabel}</a>}
        </div>
        {hasBullets && <ul class="figma-hero-badges" aria-label="EasyPM highlights">
          {props.bullets!.map((bullet) => <li>{bullet}</li>)}
        </ul>}
      </div>
      {hasFigmaMedia && (
        <div class={`figma-hero-media w-full max-w-xl mx-auto lg:max-w-none ${figmaSideContain ? 'figma-hero-media--contain' : ''}`}>
          {figmaVideoEmbedUrl ? (
            <div class="figma-hero-video relative w-full aspect-video rounded-2xl overflow-hidden shadow-2xl bg-black border border-white/10">
              <iframe
                class="absolute top-0 left-0 w-full h-full border-0"
                src={figmaVideoEmbedUrl}
                title="EasyPM Bed Bug Exterminator Video"
                width="800"
                height="450"
                loading="eager"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          ) : (
            <img src={figmaVideoImage} srcset={figmaVideoSrcSet} sizes="(max-width: 767px) 100vw, (max-width: 1199px) 48vw, 802px" alt={props.sideImage?.alt ?? 'EasyPM hero artwork'} width="802" height="513" loading="eager" fetchpriority="high" decoding="async" />
          )}
        </div>
      )}
    </div>
  </section>
) : (
<section
  class={`hero-v5 ${backgroundImageUrl ? 'has-background' : ''}`}
  style={backgroundImageUrl ? `--hero-background: url("${backgroundImageUrl}")` : undefined}
>
  <div class="hero-v5-wrap">
    <div class={`hero-v5-grid ${hasSide ? "with-side" : "no-side"}`}>
      <div class="hero-v5-content">
        {props.subtitle && (
          <div class="hero-v5-meta">
            <span class="hero-v5-meta-dot" aria-hidden="true"></span>
            <span class="hero-v5-meta-text">{props.subtitle}</span>
          </div>
        )}

        {titleSegments.length > 0 && (
          <h1 class="hero-v5-h1">
            {titleSegments.map((segment) =>
              segment.highlight ? (
                <span class="leaf">{segment.text}</span>
              ) : (
                <span>{segment.text}</span>
              ),
            )}
          </h1>
        )}

        {bodyHtml && (
          <div class="hero-v5-byline" set:html={bodyHtml} />
        )}

        {/* Single-column hero with image stage — renders only when both
            conditions are true:
              1. layoutStyle is oneColumn (no right-side bento)
              2. Sanity sideImage is uploaded
            Otherwise (e.g., blog index, terms pages, any heading-only
            hero) the image stage and the floating overlay badges are
            skipped entirely so the hero shows just heading + body + CTAs. */}
        {!hasSide && hasSideImage && (
          <figure class="hero-v5-image-stage has-image">
            <img
              src={heroStageImageUrl}
              srcset={heroStageSrcSet}
              sizes="(min-width: 1100px) 1100px, 100vw"
              alt={props.sideImage?.alt ?? ''}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width={1100}
              height={471}
            />

          </figure>
        )}

        {(props.primaryCtaLabel || props.secondaryCtaLabel) && (
          <div class="hero-v5-ctas">
            {props.primaryCtaLabel && primaryCtaHref && (
              <a href={primaryCtaHref} class="btn-primary" style="color: #fff">
                {props.primaryCtaLabel}
                <svg viewBox="0 0 24 24" class="hero-v5-cta-arrow" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
            {props.secondaryCtaLabel && secondaryCtaHref && (
              <a href={secondaryCtaHref} class="btn-ghost" style="color: #fff">
                {props.secondaryCtaLabel}
              </a>
            )}
          </div>
        )}

        {hasBullets && (
          <div class="hero-v5-trust-wrap">
            {(props as any).bulletsTitle && (
              <p class="hero-v5-trust-title">{(props as any).bulletsTitle}</p>
            )}
            <ul class="hero-v5-trust">
              {props.bullets!.map((item) => (
                <li>
                  <span class="hero-v5-trust-mark" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {hasSide && (
        <aside class={`hero-v5-side hero-v5-side--${sideFrame}`} aria-label="Hero feature">
          {sideFrame === 'card' && (
            <div class="hero-v5-side-head">
              <span>What we do</span>
              <span class="hero-v5-side-tag">Live in the metro</span>
            </div>
          )}
          <div class="hero-v5-side-image">
            <img
              src={sideImageUrl}
              srcset={sideImageSrcSet}
              sizes={sideImageSizes}
              alt={props.sideImage?.alt ?? ""}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width={sideImageSize}
              height={sideImageSize}
            />
          </div>
        </aside>
      )}
    </div>
  </div>
</section>
)}

<style>
  .figma-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 885px;
    background: #292929 var(--figma-hero-background) center / cover no-repeat;
    color: #fff;
    font-family: 'Inter', var(--font-heading);
  }
  .figma-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0, 0, 0, .80), rgba(0, 0, 0, .52) 52%, rgba(0, 0, 0, .22));
  }
  .figma-hero--compact { min-height: 360px; padding: 56px 0; }
  .figma-hero--compact .figma-hero-inner { width: min(100% - 48px, 1100px); }
  .figma-hero--compact h1 { font-size: clamp(32px, 3.2vw, 48px); }
  .figma-hero--compact .figma-hero-body { font-size: clamp(16px, 1.2vw, 20px); line-height: 1.4; }
  .figma-hero-inner { width: min(100% - 10%, 1730px); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 769fr) minmax(0, 802fr); gap: clamp(42px, 7.4vw, 142px); align-items: center; }
  .figma-hero-copy { min-width: 0; }
  @media (min-width: 1200px) {
    .figma-hero-copy { transform: translateY(-31px); }
    .figma-hero-media { transform: translateY(-18px); }
  }
  .figma-hero h1 { margin: 0 0 24px; max-width: 780px; color: #fff; font: 700 clamp(38px, 2.92vw, 56px)/1.22 'Inter', var(--font-heading); letter-spacing: 0; text-transform: uppercase; }
  .figma-hero-eyebrow { margin: 0 0 20px; color: #fff; font: 700 16px/1.25 'Inter', var(--font-heading); letter-spacing: .03em; }
  .figma-hero-accent { color: #8648e7; }
  .figma-hero-body { max-width: 735px; color: #fff; font: 700 clamp(18px, 1.25vw, 24px)/1.21 'Inter', var(--font-heading); }
  .figma-hero-body :global(p) { margin: 0; color: #fff; }
  .figma-hero-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
  .figma-hero-actions a { display: inline-flex; align-items: center; justify-content: center; min-height: 53px; min-width: 196px; padding: 12px 25px; border-radius: 8px; color: #fff; font: 700 17px/1.2 'Inter', var(--font-heading); text-decoration: none; transition: transform .18s, box-shadow .18s, background-color .18s; }
  .figma-hero-actions a:hover, .figma-hero-actions a:focus-visible { transform: translateY(-2px); box-shadow: 0 8px 18px #0004; }
  .figma-hero-actions a:active { transform: scale(.98); box-shadow: 0 2px 6px #0005; }
  .figma-hero-actions a:focus-visible, .figma-hero-media a:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .figma-hero-primary { background: linear-gradient(90deg, #8648e7, #a144ed); box-shadow: 0 3px 6px #0005; }
  .figma-hero-secondary { border: 1px solid #fff; background: #ffffff0d; }
  .figma-hero-secondary:hover { background: #ffffff25; }
  .figma-hero-badges { display: flex; flex-wrap: wrap; gap: 10px; padding: 0; margin: 22px 0 0; list-style: none; }
  .figma-hero-badges li { padding: 7px 11px; border: 1px solid #fff9; border-radius: 999px; background: #0004; color: #fff; font: 600 13px/1.2 'Inter', var(--font-heading); }
  .figma-hero-media { width: 100%; min-width: 0; max-width: 36rem; margin-inline: auto; }
  .figma-hero-video { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 1rem; background: #000; border: 1px solid #ffffff1a; box-shadow: 0 20px 40px #0005; }
  .figma-hero-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .figma-hero-video:focus-within { outline: 3px solid #fff; outline-offset: 4px; }
  .figma-hero-media a { display: block; border-radius: 15px; }
  .figma-hero-media img { display: block; width: 100%; height: auto; aspect-ratio: 802 / 513; border-radius: 15px; object-fit: cover; box-shadow: 0 4px 16px #0003; }
  .figma-hero-media--contain img { object-fit: contain; box-shadow: none; }
  @media (prefers-reduced-motion: no-preference) {
    .figma-hero-copy > * { animation: figma-hero-enter 360ms ease-out both; }
    .figma-hero-copy > :nth-child(2) { animation-delay: 50ms; }
    .figma-hero-copy > :nth-child(3) { animation-delay: 100ms; }
    .figma-hero-copy > :nth-child(4) { animation-delay: 150ms; }
    @keyframes figma-hero-enter { from { opacity: .82; translate: 0 8px; } to { opacity: 1; translate: 0 0; } }
  }
  .figma-hero--solo .figma-hero-inner { display: block; width: min(100% - 40px, 920px); text-align: center; }
  .figma-hero--solo h1, .figma-hero--solo .figma-hero-body { max-width: 920px; margin-inline: auto; }
  .figma-hero--solo .figma-hero-actions { justify-content: center; }
  @media (min-width: 1200px) { .figma-hero--solo .figma-hero-copy { transform: none; } }
  @media (max-width: 1199px) {
    .figma-hero { min-height: 650px; padding: 76px 0 112px; }
    .figma-hero.figma-hero--compact { min-height: 340px; padding: 52px 0; }
    .figma-hero-inner { width: min(100% - 64px, 1100px); gap: 36px; }
    .figma-hero h1 { font-size: clamp(32px, 3.9vw, 48px); }
    .figma-hero-body { font-size: clamp(17px, 1.8vw, 22px); }
  }
  @media (min-width: 1024px) { .figma-hero-media { max-width: none; } }
  @media (max-width: 1023px) { .figma-hero-inner { grid-template-columns: 1fr; } }
  @media (max-width: 767px) {
    .figma-hero::before { background: linear-gradient(180deg, rgba(0, 0, 0, .76), rgba(0, 0, 0, .58) 68%, rgba(0, 0, 0, .38)); }
    .figma-hero { min-height: 0; padding: 64px 0 118px; }
    .figma-hero.figma-hero--compact { min-height: 0; padding: 48px 0; }
    .figma-hero-inner { width: min(100% - 40px, 600px); grid-template-columns: 1fr; gap: 40px; }
    .figma-hero h1 { font-size: clamp(34px, 8vw, 48px); line-height: 1.16; }
    .figma-hero-body { font-size: 18px; line-height: 1.4; }
    .figma-hero-actions { display: grid; gap: 12px; }
    .figma-hero-actions a { width: 100%; min-height: 52px; }
    .figma-hero-badges { gap: 8px; }
  }
  /* === v5-modern Hero ==============================================
   * Padding tightened so the hero fits the viewport on initial load
   * without forcing a scroll on common 720–900px laptop screens.
   */
  .hero-v5 {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 36px 0 64px;
    background: var(--warm-white);
    color: var(--ink-soft);
  }

  /* Figma's desktop hero uses a full-bleed photo with a dark reading veil. */
  .hero-v5.has-background {
    min-height: 430px;
    display: flex;
    align-items: center;
    background: var(--neutral-dark);
  }

  .hero-v5.has-background::before {
    inset: 0;
    width: auto;
    height: auto;
    border-radius: 0;
    filter: none;
    opacity: 1;
    background:
      linear-gradient(90deg, rgba(20, 20, 20, .82) 0%, rgba(20, 20, 20, .58) 48%, rgba(20, 20, 20, .25) 100%),
      var(--hero-background) center / cover no-repeat;
  }

  .hero-v5.has-background .hero-v5-grid.no-side .hero-v5-content {
    align-items: flex-start;
    text-align: left;
    max-width: 780px;
  }

  .hero-v5.has-background .hero-v5-grid.no-side .hero-v5-meta,
  .hero-v5.has-background .hero-v5-grid.no-side .hero-v5-byline {
    margin-left: 0;
    margin-right: 0;
  }

  .hero-v5.has-background .hero-v5-h1,
  .hero-v5.has-background .hero-v5-byline,
  .hero-v5.has-background .hero-v5-trust li,
  .hero-v5.has-background .hero-v5-trust-title {
    color: #fff;
  }

  .hero-v5.has-background .hero-v5-h1 .leaf { color: #c98aff; }
  .hero-v5.has-background .hero-v5-meta {
    color: #fff;
    background: rgba(34, 28, 43, .72);
    border-color: rgba(255, 255, 255, .26);
  }
  .hero-v5.has-background .hero-v5-byline :global(p) { color: #fff; }
  .hero-v5.has-background .hero-v5-ctas :global(.btn-primary) { color: #fff; }
  .hero-v5.has-background .hero-v5-ctas :global(.btn-ghost) {
    color: #fff;
    background: rgba(30, 30, 30, .42);
    border-color: rgba(255, 255, 255, .7);
  }
  .hero-v5.has-background .hero-v5-trust-mark { background: rgba(255,255,255,.2); color: #fff; }

  @media (max-width: 720px) {
    .hero-v5.has-background { min-height: 480px; }
    .hero-v5.has-background .hero-v5-grid.no-side .hero-v5-content { align-items: center; text-align: center; }
    .hero-v5.has-background .hero-v5-grid.no-side .hero-v5-meta,
    .hero-v5.has-background .hero-v5-grid.no-side .hero-v5-byline { margin-left: auto; margin-right: auto; }
  }

  /* Soft radial flourishes — green at top-right, warm orange at bottom-left */
  .hero-v5::before {
    content: "";
    position: absolute;
    top: -180px;
    right: -160px;
    width: 720px;
    height: 720px;
    background: radial-gradient(
      circle at 30% 30%,
      var(--green-bio) 0%,
      var(--green-primary) 40%,
      transparent 70%
    );
    opacity: 0.18;
    filter: blur(40px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-v5::after {
    content: "";
    position: absolute;
    bottom: -200px;
    left: -180px;
    width: 560px;
    height: 560px;
    background: radial-gradient(circle, var(--heat-orange) 0%, transparent 60%);
    opacity: 0.08;
    filter: blur(40px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-v5-wrap {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-v5-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .hero-v5-grid.with-side {
    grid-template-columns: 1fr;
  }

  @media (min-width: 980px) {
    .hero-v5-grid.with-side {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  /* On mobile, the 2-column hero stacks (image below content). Center
     everything in the content column so it reads as a unified, balanced
     hero — same pattern as the 1-column variant. Desktop ≥980px keeps
     the side-by-side left-aligned layout. */
  @media (max-width: 979px) {
    .hero-v5-grid.with-side .hero-v5-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
    }
    .hero-v5-grid.with-side .hero-v5-meta {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-v5-grid.with-side .hero-v5-byline {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-v5-grid.with-side .hero-v5-ctas {
      justify-content: center;
      width: 100%;
