---
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-700.css';
import type { TwoColTextImageSection } from "../../types/sections";
import { portableTextToHtml } from "../../lib/portableText";
import { splitHighlight, titleCaseHeading } from "../../utils/highlightTitle";
import {
  buildSanityImageUrl,
  optimizeImageUrl,
  type SanityImageSource,
} from "../../lib/imageOptimizer";
import { normalizeInternalHref } from "../../lib/links";
import { getYouTubeEmbedUrl } from '../../lib/youtube';
import YouTubeEmbed from '../media/YouTubeEmbed.astro';

const props = Astro.props as TwoColTextImageSection;
const imageLeft = props.imagePlacement === "imageLeft";
const ctaHref = normalizeInternalHref(props.ctaLink);
const secondaryCtaHref = normalizeInternalHref(props.secondaryCtaLink);
const normalizeImage = (
  img?:
    | string
    | {
        url?: string;
        alt?: string;
        imageUrl?: string;
        src?: string;
        crop?: { top: number; bottom: number; left: number; right: number };
        hotspot?: { x: number; y: number; height: number; width: number };
        image?: {
          url?: string;
          src?: string;
          crop?: { top: number; bottom: number; left: number; right: number };
          hotspot?: { x: number; y: number; height: number; width: number };
          asset?: {
            _ref?: string;
            _id?: string;
            _type?: string;
            url?: string;
            src?: string;
          };
        };
        asset?: {
          _ref?: string;
          _id?: string;
          _type?: string;
          url?: string;
          src?: string;
        };
      },
) => {
  if (!img) return null;
  if (typeof img === "string") {
    return { url: img, alt: props.title, source: undefined };
  }

  const url =
    img.url ||
    img.src ||
    img.imageUrl ||
    img.image?.url ||
    img.image?.src ||
    img.image?.asset?.url ||
    img.image?.asset?.src ||
    img.asset?.url ||
    img.asset?.src;
  if (!url) return null;

  const source =
    img.image && (img.image.asset || img.image.url)
      ? ({
          url: img.image.url,
          asset: img.image.asset,
          crop: img.image.crop,
          hotspot: img.image.hotspot,
        } satisfies SanityImageSource)
      : img.asset || img.url
        ? ({
            url: img.url,
            asset: img.asset,
            crop: img.crop,
            hotspot: img.hotspot,
          } satisfies SanityImageSource)
        : undefined;

  return { url, alt: img.alt ?? props.title, source };
};

const gallery = props.images?.length
  ? props.images.map((img) => normalizeImage(img)).filter(Boolean) as {
      url: string;
      alt?: string;
      source?: SanityImageSource;
    }[]
  : normalizeImage(props.image)
    ? [normalizeImage(props.image)!]
    : [];
const rawBackgroundTheme = props.backgroundTheme ?? "white";
const backgroundTheme =
  (
    {
      blue: "oliveGreen",
      darkBlue: "darkGreen",
      yellow: "cream",
    } as Record<string, string>
  )[rawBackgroundTheme] ?? rawBackgroundTheme;

/**
 * Theme classes use scoped CSS rules (defined in this file's <style>
 * block) instead of Tailwind arbitrary values like `bg-[--green-deep]`.
 * Tailwind v4 silently drops that legacy syntax, which previously
 * caused white text to render on a default warm-white bg (invisible).
 *
 * Background palette unified with CtaSection's sectionBackground field:
 *   white       — surface-white   (light text scheme)
 *   soft-green  — surface-soft-green (light text scheme)
 *   sage        — surface-sage    (light text scheme)
 *   cream       — sand-pale       (light text scheme)
 *   oliveGreen  — Figma reference light surface (legacy schema value)
 *   darkGreen   — legacy name for the client's light-purple content surface
 */
const themeConfig = {
  white: {
    base: "bbg-twocol-theme-white",
    title: "bbg-twocol-title-light",
    subtitle: "bbg-twocol-sub-light",
    highlight: "bbg-twocol-highlight",
    isDark: false,
  },
  "soft-green": {
    base: "bbg-twocol-theme-softgreen",
    title: "bbg-twocol-title-light",
    subtitle: "bbg-twocol-sub-light",
    highlight: "bbg-twocol-highlight",
    isDark: false,
  },
  sage: {
    base: "bbg-twocol-theme-sage",
    title: "bbg-twocol-title-light",
    subtitle: "bbg-twocol-sub-light",
    highlight: "bbg-twocol-highlight",
    isDark: false,
  },
  cream: {
    base: "bbg-twocol-theme-cream",
    title: "bbg-twocol-title-light",
    subtitle: "bbg-twocol-sub-light",
    highlight: "bbg-twocol-highlight",
    isDark: false,
  },
  oliveGreen: {
    base: "bbg-twocol-theme-olive",
    title: "bbg-twocol-title-light",
    subtitle: "bbg-twocol-sub-light",
    highlight: "bbg-twocol-highlight",
    isDark: false,
  },
  darkGreen: {
    base: "bbg-twocol-theme-darkgreen",
    title: "bbg-twocol-title-light",
    subtitle: "bbg-twocol-sub-light",
    highlight: "bbg-twocol-highlight",
    isDark: false,
  },
} as const;

const theme =
  themeConfig[backgroundTheme as keyof typeof themeConfig] ?? themeConfig.white;
const baseClasses = theme.base;
const titleColor = theme.title;
const mutedClass = theme.subtitle;
const subtitleClass = theme.isDark ? "subtitle-dark" : "subtitle";
const highlightClass = theme.highlight;
const galleryCount = gallery.length;
const localCropStyle = (image: { url: string; source?: SanityImageSource }) => {
  if (!image.url.startsWith('/') || !image.source?.crop) return undefined;
  const { left, right, top, bottom } = image.source.crop;
  const visibleWidth = 1 - left - right;
  const visibleHeight = 1 - top - bottom;
  if (visibleWidth <= 0 || visibleHeight <= 0) return undefined;
  return `width:${100 / visibleWidth}%;height:${100 / visibleHeight}%;left:${-100 * left / visibleWidth}%;top:${-100 * top / visibleHeight}%;max-width:none;max-height:none`;
};
const videoEmbedUrl = getYouTubeEmbedUrl(props.videoUrl);
const hasMedia = Boolean(videoEmbedUrl || galleryCount > 0);
const descriptionHtml = props.description
  ? portableTextToHtml(props.description, theme.isDark)
  : "";
const descriptionColorClass = theme.isDark ? "prose-invert text-white/90" : "text-[--color-text]";
const titleSegments = props.title ? splitHighlight(titleCaseHeading(props.title), props.highlightText) : [];
const hasPrimaryCta = Boolean(props.ctaLabel && ctaHref);
const hasSecondaryCta = Boolean(props.secondaryCtaLabel && secondaryCtaHref);
const isSingleImage = galleryCount === 1;
const containSingleImage = isSingleImage && props.mediaFit === 'contain';

const galleryClasses = (() => {
  if (galleryCount === 1) return "grid gap-4";
  if (galleryCount >= 3) return `grid gap-6 md:grid-cols-2 md:grid-rows-2 ${galleryCount === 3 ? 'is-stack' : 'is-four'}`;
  return "grid gap-4";
})();

// Preserve the three-photo gallery's face framing; center balanced photo grids.
const objectPositionClass = galleryCount === 3 ? "object-[50%_20%]" : "object-center";

// Single-image URLs use fit: crop with width + height so Sanity's
// hotspot/crop is honored — matches how the multi-image gallery cells
// already build their sources.
// Photography uses a 4:3 crop, with minimum frame heights in shared CSS.
const SINGLE_IMAGE_ASPECT_DESKTOP = 3 / 4;
const SINGLE_IMAGE_ASPECT_MOBILE = 3 / 4;

const buildSingleImageSrcInternal = (
  image: { url: string; source?: SanityImageSource },
  width: number,
  aspect: number,
) => {
  const height = Math.round(width * aspect);
  const quality = width <= 768 ? 74 : 78;
  return image.source
    ? buildSanityImageUrl(image.source, {
        width,
        height,
        quality,
        format: "webp",
        fit: "crop",
      }) ||
        optimizeImageUrl(image.url, {
          width,
          height,
          quality,
          format: "webp",
          fit: "crop",
        })
    : optimizeImageUrl(image.url, {
        width,
        height,
        quality,
        format: "webp",
        fit: "crop",
      });
};

const buildSingleImageSrc = (
  image: { url: string; source?: SanityImageSource },
  width: number,
) => buildSingleImageSrcInternal(image, width, SINGLE_IMAGE_ASPECT_DESKTOP);

const buildSingleImageSrcMobile = (
  image: { url: string; source?: SanityImageSource },
  width: number,
) => buildSingleImageSrcInternal(image, width, SINGLE_IMAGE_ASPECT_MOBILE);

const buildContainedImageSrc = (
  image: { url: string; source?: SanityImageSource },
  width: number,
) => image.source
  ? buildSanityImageUrl(image.source, { width, quality: 82, format: 'webp', fit: 'max' })
    || optimizeImageUrl(image.url, { width, quality: 82, format: 'webp', fit: 'max' })
  : optimizeImageUrl(image.url, { width, quality: 82, format: 'webp', fit: 'max' });

const buildGalleryCropSrc = (
  image: { url: string; source?: SanityImageSource },
  width: number,
  height: number,
  quality: number,
) =>
  image.source
    ? buildSanityImageUrl(image.source, {
        width,
        height,
        quality,
        format: "webp",
        fit: "crop",
      }) || optimizeImageUrl(image.url, {
        width,
        height,
        quality,
        format: "webp",
        fit: "crop",
      })
    : optimizeImageUrl(image.url, {
        width,
        height,
        quality,
        format: "webp",
        fit: "crop",
      });

const getImageSpanClasses = (index: number) => {
  if (galleryCount === 1) {
    // Aspect-ratio container + object-cover so the image fills the
    // column and visually balances the text. Sanity hotspot/crop is
    // honored via the buildSingleImageSrc URL (fit: crop).
    return "bbg-twocol-single rounded-[24px] w-full aspect-[4/3]";
  }
  if (galleryCount >= 3) {
    if (galleryCount === 4) return 'rounded-2xl aspect-[4/3] w-full';
    return index === 0 ? 'bbg-twocol-feature' : 'bbg-twocol-stacked';
  }
  return "rounded-[28px] aspect-[4/3] w-full";
};

// Match the three-photo grid's portrait feature and landscape frames.
const buildGalleryFrameSrc = (
  image: { url: string; source?: SanityImageSource },
  index: number,
  width: number,
  height: number,
  quality: number,
) => buildGalleryCropSrc(
  image,
  width,
  galleryCount === 3 ? Math.round(width * (index === 0 ? 4 / 3 : 3 / 4)) : height,
  quality,
);
---

<section id={props.anchorId} class={`section-full-width-lg bbg-twocol-section ${baseClasses}`}>
  <div
    class={`section-container bbg-twocol-grid ${imageLeft ? "is-image-left" : "is-image-right"} ${hasMedia ? '' : 'has-no-image'}`}
  >
    <div class="bbg-twocol-content">
      {
        props.title && (
          <h2 class={`bbg-twocol-title ${titleColor}`}>
            {
              titleSegments.map((segment) =>
                segment.highlight ? (
                  <span class={highlightClass}>{segment.text}</span>
                ) : (
                  <span class={titleColor}>{segment.text}</span>
                ),
              )
            }
          </h2>
        )
      }
      {
        props.subtitle && props.subtitle.trim().length > 0 && (
          <p
            class={subtitleClass}
          >
            {props.subtitle.trim()}
          </p>
        )
      }
      {
        descriptionHtml && (
          <div
            class={`section-description prose max-w-none space-y-4 text-sm md:text-base ${descriptionColorClass}`}
            set:html={descriptionHtml}
          />
        )
      }
      {
        props.bullets && props.bullets.length > 0 && (
          <div class="bbg-twocol-bullets">
            {props.bulletTitle && (
              <p class={`bbg-twocol-bullet-title ${mutedClass}`}>
                {props.bulletTitle}
              </p>
            )}
            <ul class="bbg-twocol-bullet-list">
              {props.bullets.map((bullet) => (
                <li class={`bbg-twocol-bullet ${mutedClass}`}>
                  {(props.bulletIcon ?? 'check') === 'circle' ? (
                    <span class="bbg-twocol-bullet-mark is-circle" aria-hidden="true" />
                  ) : (
                    <span class="bbg-twocol-bullet-mark is-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12l5 5L20 7" />
                      </svg>
                    </span>
                  )}
                  <span>{titleCaseHeading(bullet)}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        (hasPrimaryCta || hasSecondaryCta) && (
          <div class="bbg-twocol-ctas">
            {hasPrimaryCta && (
              <a href={ctaHref} class="btn-primary">
                {props.ctaLabel}
              </a>
            )}
            {hasSecondaryCta && (
              <a href={secondaryCtaHref} class="btn-primary">
                {props.secondaryCtaLabel}
              </a>
            )}
          </div>
        )
      }
    </div>
    {hasMedia && <div
      class={`flex items-center justify-center w-full ${galleryCount >= 3 ? "md:items-stretch" : ""}`}
    >
      {videoEmbedUrl ? <YouTubeEmbed url={props.videoUrl!} /> :
        (
          <div
            class={`w-full bbg-twocol-gallery ${galleryCount >= 3 ? "is-multi" : "is-single"} ${containSingleImage ? 'is-contained' : ''} ${galleryClasses} ${galleryCount >= 3 ? "md:auto-rows-max md:items-center" : ""}`}
          >
            {gallery.slice(0, 4).map((image, index) => (
              <div
                class={`overflow-hidden ${galleryCount === 1 ? "relative w-full" : "relative max-h-80 md:max-h-none"} ${containSingleImage ? 'bg-white' : ''} ${getImageSpanClasses(index)}`}
              >
                {isSingleImage ? (
                  <picture class={containSingleImage ? undefined : 'absolute inset-0 h-full w-full'} style={containSingleImage ? undefined : localCropStyle(image)}>
                    {/* Responsive photography keeps the shared 4:3 crop. */}
                    <source
                      media="(max-width: 767px)"
                      srcset={containSingleImage ? `${buildContainedImageSrc(image, 480)} 480w, ${buildContainedImageSrc(image, 768)} 768w` : `${buildSingleImageSrcMobile(image, 480)} 480w, ${buildSingleImageSrcMobile(image, 768)} 768w`}
                      sizes="100vw"
                    />
                    {/* Smaller sources support narrow desktop columns. */}
                    <img
                      src={containSingleImage ? buildContainedImageSrc(image, 1200) : buildSingleImageSrc(image, 1200)}
                      srcset={containSingleImage ? `${buildContainedImageSrc(image, 480)} 480w, ${buildContainedImageSrc(image, 768)} 768w, ${buildContainedImageSrc(image, 1200)} 1200w` : `${buildSingleImageSrc(image, 480)} 480w, ${buildSingleImageSrc(image, 600)} 600w, ${buildSingleImageSrc(image, 768)} 768w, ${buildSingleImageSrc(image, 1200)} 1200w, ${buildSingleImageSrc(image, 1600)} 1600w`}
                      sizes="(max-width: 768px) 100vw, 50vw"
                      alt={image.alt ?? props.title}
                      width={1200}
                      height={900}
                      class={`absolute inset-0 h-full w-full ${containSingleImage ? 'object-contain p-8 md:p-12' : 'object-cover object-center'}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                ) : (
                  <picture class="absolute inset-0 h-full w-full" style={localCropStyle(image)}>
                    <source
                      media="(max-width: 768px)"
                      srcset={`${buildGalleryFrameSrc(image, index, 380, 300, 70)} 380w, ${buildGalleryFrameSrc(image, index, 640, 400, 72)} 640w`}
                      sizes={galleryCount === 3 ? '(max-width: 767px) 40vw, 22vw' : '(max-width: 768px) 100vw'}
                    />
                    {/* 380w added for narrow desktop columns. */}
                    <img
                      src={buildGalleryFrameSrc(image, index, 900, 675, 78)}
                      srcset={`${buildGalleryFrameSrc(image, index, 380, 285, 70)} 380w, ${buildGalleryFrameSrc(image, index, 480, 360, 72)} 480w, ${buildGalleryFrameSrc(image, index, 768, 576, 75)} 768w, ${buildGalleryFrameSrc(image, index, 1200, 900, 78)} 1200w`}
                      sizes={galleryCount === 3 ? '(max-width: 767px) 40vw, 22vw' : '(max-width: 768px) 100vw, 50vw'}
                      alt={image.alt ?? props.title}
                      width={800}
                      height={galleryCount === 3 && index === 0 ? 1067 : 600}
                      class={`absolute inset-0 h-full w-full object-cover ${objectPositionClass}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
              </div>
            ))}
          </div>
        )
      }
    </div>}
  </div>
</section>

<style>
  .bbg-twocol-gallery.is-multi { column-gap: 24px; row-gap: 24px; }
  .bbg-twocol-gallery.is-four { align-items: stretch; }
  .bbg-twocol-gallery.is-stack { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: center; }
  .bbg-twocol-gallery.is-stack > div { width: 100%; min-width: 0; max-height: none; margin: 0; border-radius: 16px; box-shadow: var(--button-shadow-md); }
  .bbg-twocol-gallery.is-stack > .bbg-twocol-feature { grid-column: 2; grid-row: 1 / span 2; aspect-ratio: 3 / 4; align-self: center; }
  .bbg-twocol-gallery.is-stack > .bbg-twocol-stacked { grid-column: 1; aspect-ratio: 4 / 3; }
  .bbg-twocol-gallery.is-stack > div:nth-child(2) { grid-row: 1; }
  .bbg-twocol-gallery.is-stack > div:nth-child(3) { grid-row: 2; }
  @media (min-width: 1024px) { .bbg-twocol-gallery.is-stack { gap: 24px; } }
  /* === Section grid ===============================================
     Replaces the previous Tailwind grid + space-y-5 utility chain.
     space-y-5 was silently dropping under Tailwind v4 in scoped Astro
     context, leaving title/subtitle/body crammed together. Explicit
     CSS makes spacing predictable regardless of which children render. */
  .bbg-twocol-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .bbg-twocol-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
    padding: clamp(24px, 3vw, 48px);
    border: 1px solid #e3dcec;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.051);
  }
  .bbg-twocol-section:is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) { padding-block: 64px; }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-content { min-width: 0; gap: 24px; }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-title { color: #0f172a; font-size: clamp(30px, 3.2vw, 40px); font-weight: 800; }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .section-description { max-width: 576px; color: #475569; font-size: clamp(16px, 1.5vw, 18px); font-weight: 400; }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .section-description :global(p) { color: inherit; }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-ctas { padding-top: 0; }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-ctas a { background: var(--purple-primary); color: var(--button-text); font-weight: 700; box-shadow: var(--button-shadow-md); }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-ctas a:is(:hover, :focus-visible) { background: var(--purple-hover); color: var(--button-text); }
  :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-ctas a:focus-visible { outline-color: var(--purple-hover); }
  @media (min-width: 1024px) {
    .bbg-twocol-section:is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) { padding-block: 96px; }
    :is(.bbg-twocol-theme-darkgreen, .bbg-twocol-theme-olive) .bbg-twocol-grid:not(.has-no-image) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; }
  }
  .bbg-twocol-gallery.is-single > div { border-radius: 24px; box-shadow: 0 20px 42px rgba(15, 23, 42, 0.149); }
  .bbg-twocol-grid.has-no-image { grid-template-columns: minmax(0, 1fr); }
  .bbg-twocol-grid.has-no-image .bbg-twocol-content { max-width: 850px; }

  @media (min-width: 768px) {
    .bbg-twocol-grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
    .bbg-twocol-grid.has-no-image { grid-template-columns: minmax(0, 1fr); }
    .bbg-twocol-grid.is-image-left .bbg-twocol-content { order: 2; }
    .bbg-twocol-grid.is-image-left > div:last-child   { order: 1; }
  }

  /* Content column — gap-driven flex column so every direct child gets
     a consistent 20px vertical rhythm with or without the subtitle. */
  .bbg-twocol-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* H2 sized to match every other section heading across the site —
     same scale and weight, brand-consistent. */
  .bbg-twocol-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin: 0;
  }

  /* === Theme variants — scoped so Tailwind v4 can't silently drop them. */
  .bbg-twocol-theme-white     { background: var(--surface-white);      color: var(--ink-soft); }
  .bbg-twocol-theme-softgreen { background: var(--surface-soft-green); color: var(--ink-soft); }
  .bbg-twocol-theme-sage      { background: var(--surface-sage);       color: var(--ink-soft); }
  .bbg-twocol-theme-cream     { background: var(--sand-pale);          color: var(--ink-soft); }
  /* Preserve the stored theme value while using the client's neutral palette. */
  .bbg-twocol-theme-olive {
    --font-heading: var(--figma-font-heading);
    --font-body: var(--figma-font-body);
    --purple-primary: var(--figma-purple-primary);
    --purple-hover: var(--figma-purple-secondary);
    --button-text: var(--figma-surface-base);
    background: var(--figma-surface-base);
    color: var(--figma-text-body);
  }
  .bbg-twocol-theme-olive .bbg-twocol-title { font-family: var(--figma-font-heading); font-size: var(--figma-h2-size); line-height: var(--figma-heading-leading); }
  .bbg-twocol-theme-olive .bbg-twocol-title-light { color: var(--figma-text-strong); }
  .bbg-twocol-theme-olive .section-description { color: var(--figma-text-body); font-family: var(--figma-font-body); font-size: var(--figma-body-s-size); line-height: var(--figma-body-s-leading); }
  .bbg-twocol-theme-olive .bbg-twocol-sub-light { color: var(--figma-text-body); }
  .bbg-twocol-theme-olive .bbg-twocol-gallery.is-four { gap: 16px; }
  @media (min-width: 640px) { .bbg-twocol-theme-olive .bbg-twocol-gallery.is-four { gap: 20px; } }
  .bbg-twocol-theme-darkgreen { background: var(--surface-white);      color: #334155; }
  :global(.figma-estimate-strip) + .bbg-twocol-theme-darkgreen { background: var(--purple-soft); }
  .bbg-twocol-theme-darkgreen .bbg-twocol-title-light { color: #0f172a; }
  .bbg-twocol-theme-darkgreen .section-description { color: #334155; }
