---
import type { ServiceAreaSection } from '../../types/sections';
import { splitHighlight, titleCaseHeading } from '../../utils/highlightTitle';
import { buildSanityImageUrl, optimizeImageUrl, type SanityImageSource } from '../../lib/imageOptimizer';
import { normalizeInternalHref } from '../../lib/links';
import CtaSubtitle from '../ui/CtaSubtitle.astro';

const props = Astro.props as ServiceAreaSection;

const resolveLink = (link?: string) => normalizeInternalHref(link);

const isImageUrl = (url?: string) => {
  if (!url) return false;
  return /\.(png|jpe?g|webp|svg)(\?.*)?$/i.test(url);
};

const ctaLink = resolveLink(props.ctaLink);
const imageSource = props.image
  ? ({
      url: props.image.url,
      asset: props.image.asset,
      crop: props.image.crop,
      hotspot: props.image.hotspot
    } satisfies SanityImageSource)
  : undefined;
const imageUrl = props.image?.url ?? props.image?.asset?.url;
const serviceAreaImageUrl = imageSource
  ? buildSanityImageUrl(imageSource, {
      width: 1100,
      quality: 78,
      format: 'webp',
      fit: 'max'
    }) || optimizeImageUrl(imageUrl, { width: 1100, fit: 'max' })
  : optimizeImageUrl(imageUrl, { width: 1100, fit: 'max' });
const embedLooksLikeImage = isImageUrl(props.mapEmbed);
const titleSegments = splitHighlight(titleCaseHeading(props.title), props.highlightText);
const highlightClass = 'bbg-sa-leaf';
const ctaSubtitlePlacement = props.ctaSubtitlePlacement ?? 'below';
const ctaSubtitleHeadingLevel = props.ctaSubtitleHeadingLevel ?? 'h3';
const hasCtaSubtitle = Boolean(props.ctaSubtitle?.trim());

const mapEmbedUrl = props.mapEmbed?.trim();
const hasMap = Boolean(mapEmbedUrl && !embedLooksLikeImage);
const hasVisual = Boolean(imageUrl || props.mapEmbed);
---

<section class="bbg-sa-section">
  <div class="bbg-sa-inner">
  <div class:list={['bbg-sa-grid', { 'has-visual': hasVisual }]}>
    <div class="bbg-sa-content">
      <div class="bbg-sa-copy">
        <span class="bbg-sa-eyebrow">Service Coverage</span>
        {props.title && (
          <h2 class="bbg-sa-title">
            {titleSegments.map((segment) =>
              segment.highlight ? (
                <span class={highlightClass}>{segment.text}</span>
              ) : (
                segment.text
              )
            )}
          </h2>
        )}
        {props.subtitle && <p class="subtitle">{props.subtitle}</p>}
        {props.description && <p class="bbg-sa-description">{props.description}</p>}
      </div>

      {props.communities?.length > 0 && (
        <ul class="bbg-sa-communities" role="list">
          {props.communities.map((community) => {
            const href = resolveLink(community.link);
            const label = (
              <span class="bbg-sa-community-label">
                {community.label}
              </span>
            );

            return (
              <li class="bbg-sa-community">
                <span class="bbg-sa-location-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="fill-current">
                    <path d="M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" />
                  </svg>
                </span>
                <div>
                  {href ? (
                    <a href={href} class="focus:outline-none focus-visible:ring-2 focus-visible:ring-(--color-primary) focus-visible:ring-offset-2">
                      {label}
                    </a>
                  ) : (
                    label
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )}

      {props.ctaLabel && ctaLink && (
        <div class="inline-flex flex-col items-center gap-3 self-start text-center w-full sm:w-auto">
          {hasCtaSubtitle && ctaSubtitlePlacement === 'above' && (
            <CtaSubtitle
              text={props.ctaSubtitle}
              headingLevel={ctaSubtitleHeadingLevel}
              class="text-slate-900 w-full text-center text-lg md:text-xl"
            />
          )}
          <a
            href={ctaLink}
            class="btn-primary inline-flex items-center gap-2 mx-auto md:mx-0"
          >
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/30">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-3.5 w-3.5 fill-current">
                <path d="M16.62 13.28c-.38-.1-.81-.02-1.1.23l-1.74 1.5a14.77 14.77 0 0 1-5.04-5.04l1.5-1.74c.3-.29.42-.72.32-1.12l-.72-2.73a1.13 1.13 0 0 0-1.09-.84H6.21A1.71 1.71 0 0 0 4.5 4.5c0 8.15 6.85 15 15 15a1.71 1.71 0 0 0 1.71-1.71v-2.24c0-.51-.34-.96-.84-1.09l-2.75-.18Z" />
              </svg>
            </span>
            {props.ctaLabel}
          </a>
          {hasCtaSubtitle && ctaSubtitlePlacement === 'below' && (
            <CtaSubtitle
              text={props.ctaSubtitle}
              headingLevel={ctaSubtitleHeadingLevel}
              class="text-slate-900 w-full text-center text-lg md:text-xl"
            />
          )}
        </div>
      )}

    </div>

    {hasVisual && <div class="relative">
      {imageUrl ? (
        <img
          src={serviceAreaImageUrl}
          alt={props.image?.alt ?? props.title ?? 'Service area image'}
          width={1100}
          loading="lazy"
          decoding="async"
          class="block h-auto w-full rounded-4xl bg-white"
        />
      ) : hasMap && mapEmbedUrl ? (
        embedLooksLikeImage ? (
          <img
            src={props.mapEmbed}
            alt={props.title ?? 'Service area image'}
            width={1100}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full rounded-4xl bg-white"
          />
        ) : (
          <iframe
            src={mapEmbedUrl}
            title={props.title ? `Map: ${props.title}` : 'Philadelphia service area map'}
            class="aspect-4/3 w-full rounded-4xl"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        )
      ) : null}
    </div>}
  </div>
  </div>
</section>

<style>
  .bbg-sa-section { width: 100%; margin: 0; padding-block: 64px; background: var(--surface-white); }
  .bbg-sa-inner { width: min(calc(100% - 2 * var(--site-gutter)), var(--site-content-width)); min-width: 0; margin-inline: auto; }
  .bbg-sa-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center; width: 100%; max-width: 896px; min-width: 0; margin-inline: auto; padding: 32px; border: 1px solid #e2e8f0cc; border-radius: 24px; background: #fff; box-shadow: 0 10px 15px -3px rgba(15, 23, 42, .1), 0 4px 6px -4px rgba(15, 23, 42, .1); }
  .bbg-sa-grid.has-visual { max-width: none; }
  .bbg-sa-content { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .bbg-sa-copy { min-width: 0; }
  .bbg-sa-eyebrow { display: inline-block; margin-bottom: 16px; padding: 4px 14px; border-radius: 999px; background: var(--purple-soft); color: var(--purple-primary); font: 600 12px/1.5 var(--font-heading); letter-spacing: .08em; text-transform: uppercase; }
  .bbg-sa-title { margin: 0 0 16px; color: #0f172a; font: 800 clamp(30px, 3.2vw, 40px)/1.15 var(--font-heading); letter-spacing: -.025em; }
  .bbg-sa-leaf { color: var(--purple-primary); font-style: inherit; }
  .bbg-sa-description { margin: 0; color: #475569; font: 400 16px/1.7 var(--font-body); }
  .bbg-sa-communities { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .bbg-sa-community { display: inline-flex; align-items: center; gap: 12px; max-width: 100%; padding: 12px 20px; border: 1px solid var(--purple-soft); border-radius: 16px; background: var(--purple-soft); color: var(--purple-primary); }
  .bbg-sa-community > div { min-width: 0; }
  .bbg-sa-community-label { color: var(--purple-primary); font: 700 16px/1.5 var(--font-heading); overflow-wrap: anywhere; }
  .bbg-sa-location-icon { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; flex: none; color: var(--purple-primary); }
  .bbg-sa-location-icon svg { width: 24px; height: 24px; }
  @media (min-width: 640px) { .bbg-sa-grid { padding: 48px; } .bbg-sa-community-label { font-size: 18px; } }
  @media (min-width: 1024px) {
    .bbg-sa-section { padding-block: 96px; }
    .bbg-sa-grid { padding: 64px; }
    .bbg-sa-grid.has-visual { grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); }
    .bbg-sa-description { font-size: 18px; }
  }

  /* Force any map/image inside the right column to stay within bounds. */
  .bbg-sa-grid :global(img),
  .bbg-sa-grid :global(iframe) {
    max-width: 100%;
    width: 100%;
    height: auto;
    display: block;
  }
</style>
