---
import type { BlogListSection } from "../../types/sections";
import { splitHighlight, titleCaseHeading } from "../../utils/highlightTitle";
import { fetchAllBlogPosts } from "../../lib/queries/allBlogPosts";
import { optimizeImageUrl } from "../../lib/imageOptimizer";
import { normalizeInternalHref } from "../../lib/links";

const props = Astro.props as BlogListSection;
const titleSegments = splitHighlight(titleCaseHeading(props.title), props.highlightText);
const rawPosts = await fetchAllBlogPosts();
const normalizeSlug = (slug: any) =>
  typeof slug === "string" ? slug : (slug?.current ?? "");
const postImageSizes =
  "(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw";
const emptyStateCtaHref = normalizeInternalHref(props.emptyStateCtaLink);

const buildPostImage = (url?: string | null) => {
  if (!url) return { src: null, srcset: null };
  const desktop = optimizeImageUrl(url, {
    width: 1000,
    height: 500,
    fit: "crop",
    quality: 82,
  });
  const tablet = optimizeImageUrl(url, {
    width: 800,
    height: 400,
    fit: "crop",
    quality: 80,
  });
  const mobile = optimizeImageUrl(url, {
    width: 600,
    height: 300,
    fit: "crop",
    quality: 78,
  });
  return {
    src: desktop,
    srcset: `${mobile} 480w, ${tablet} 720w, ${desktop} 960w`,
  };
};

// Pre-optimize images and structure data
const allPosts = rawPosts
  .map((post: any) => {
    const slug = normalizeSlug(post.slug);
    const { src, srcset } = buildPostImage(post.featuredImage?.asset?.url);
    return {
      ...post,
      slug,
      optimizedImage: src,
      optimizedImageSrcSet: srcset,
    };
  })
  .filter((post: any) => Boolean(post.slug));

const resolvedPostsPerPage = Math.max(
  1,
  typeof props.postsToShow === "number" && props.postsToShow > 0
    ? props.postsToShow
    : 9,
);
const perPageSelection =
  resolvedPostsPerPage >= allPosts.length
    ? "all"
    : String(resolvedPostsPerPage);

// Filter by category if specified
let posts: any[] = allPosts;
if (props.filterCategory) {
  posts = allPosts.filter(
    (p: any) =>
      Array.isArray(p.categories) &&
      p.categories.includes(props.filterCategory as string),
  );
}

// Initial sort (Latest)
posts.sort(
  (a, b) =>
    new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
);

const initialPosts = posts.slice(0, resolvedPostsPerPage);
const initialTotalPages = Math.ceil(posts.length / resolvedPostsPerPage);
const categoryNames = [...new Set<string>(allPosts.flatMap((post: any) => Array.isArray(post.categories) ? post.categories.filter(Boolean) : []))];
---

<section class="blog-list-section" data-blog-list data-posts-per-page={resolvedPostsPerPage} data-filter-category={props.filterCategory ?? ''}>
  <div class="blog-list-inner">
  {
    props.title && (
      <h2 class="blog-list-title">
        {titleSegments.map((segment) =>
          segment.highlight ? (
            <span class="bbg-blog-leaf">{segment.text}</span>
          ) : (
            segment.text
          ),
        )}
      </h2>
    )
  }
  {
    props.description && (
      <p class="blog-list-description">{props.description}</p>
    )
  }
  <div class="blog-category-chips" role="group" aria-label="Filter articles by category">
    <button class="blog-category-chip" type="button" data-category-chip="" aria-pressed={!props.filterCategory}>All Articles</button>
    {categoryNames.map((category) => <button class="blog-category-chip" type="button" data-category-chip={category} aria-pressed={props.filterCategory === category}>{category}</button>)}
  </div>
  <div class={allPosts.length === 0 ? 'hidden' : 'mb-8 rounded-lg border border-slate-200 bg-slate-50 p-4 sm:p-6'}>
    <div
      class="grid gap-2 sm:gap-3 md:gap-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6"
    >
      <div>
        <label
          for="categoryFilter"
          class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider"
          >Category</label
        >
        <select
          id="categoryFilter"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
        >
          <option value="">All Categories</option>
        </select>
      </div>

      <div>
        <label
          for="sortFilter"
          class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider"
          >Sort By</label
        >
        <select
          id="sortFilter"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
        >
          <option value="latest">Latest</option>
          <option value="oldest">Oldest</option>
          <option value="title-asc">Title (A-Z)</option>
          <option value="title-desc">Title (Z-A)</option>
        </select>
      </div>

      <div>
        <label
          for="dateFromFilter"
          class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider"
          >From Date</label
        >
        <input
          type="date"
          id="dateFromFilter"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
        />
      </div>

      <div>
        <label
          for="dateToFilter"
          class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider"
          >To Date</label
        >
        <input
          type="date"
          id="dateToFilter"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
        />
      </div>

      <div>
        <label
          for="perPageFilter"
          class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider"
          >Posts Per Page</label
        >
        <select
          id="perPageFilter"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
        >
          <option value="6" selected={perPageSelection === "6"}>6</option>
          <option value="9" selected={perPageSelection === "9"}>9</option>
          <option value="12" selected={perPageSelection === "12"}>12</option>
          <option value="all" selected={perPageSelection === "all"}>All</option>
        </select>
      </div>

      <div class="flex items-end">
        <button id="resetFilters" class="btn-primary"> Reset </button>
      </div>
    </div>
  </div>

  {/* Posts Grid */}
  <div>
    <div
      id="postsContainer"
      class={allPosts.length === 0 ? 'hidden' : 'mb-12 grid gap-3 sm:gap-4 md:gap-6 grid-cols-1 sm:grid-cols-2 md:grid-cols-3'}
    >
      {
        initialPosts.map((post, index) => (
          <article
            class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 cursor-pointer"
            onclick={`window.location.href='/blog/${post.slug}/'`}
          >
            {post.optimizedImage && (
              <div class="relative aspect-[2/1] w-full overflow-hidden bg-slate-100">
                <img
                  src={post.optimizedImage}
                  srcset={post.optimizedImageSrcSet ?? undefined}
                  sizes={postImageSizes}
                  alt={post.featuredImage?.alt || post.title}
                  width={1000}
                  height={500}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
                  loading={
                    index === 0 ? "eager" : "lazy"
                  }
                  fetchpriority={
                    index === 0 ? "high" : "auto"
                  }
                  decoding="async"
                />
              </div>
            )}
            <div class="p-6">
              <div class="mb-2 flex items-center gap-2">
                {post.categories &&
                  post.categories.length > 0 &&
                  post.categories.map((category: string) => (
                    <span class="blog-post-category">
                      {category}
                    </span>
                  ))}
                {post.publishedAt && (
                  <span class="text-xs text-slate-500">
                    {new Date(post.publishedAt).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                )}
              </div>
              <h3 class="mb-2 text-xl font-semibold text-slate-900 line-clamp-2">
                <a href={`/blog/${post.slug}/`} class="hover:text-[--green-primary]">
                  {post.title}
                </a>
              </h3>
              {post.excerpt && <p class="mb-4 text-slate-600 line-clamp-2">{post.excerpt}</p>}
              {post.tags && post.tags.length > 0 && (
                <div class="mb-4 flex flex-wrap gap-2">
                  {post.tags.slice(0, 3).map((tag: string) => (
                    <span class="text-xs text-slate-500">#{tag}</span>
                  ))}
                </div>
              )}
              <a href={`/blog/${post.slug}/`} class="btn-primary inline-flex">
                Read More
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div
      id="noResults"
      class:list={['blog-empty-state', { hidden: allPosts.length > 0 }]}
      role="status"
    >
      <div class="blog-empty-icon" aria-hidden="true">
        <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
          <path d="M14 3v6h6M8 13h8M8 17h5" />
        </svg>
      </div>
      <h3 class="blog-empty-title">{allPosts.length === 0 ? 'No Articles Published Yet' : 'No Matching Articles'}</h3>
      <p class="blog-empty-description">{allPosts.length === 0 ? props.emptyStateText : "No posts found matching your filters."}</p>
      {allPosts.length === 0 && props.emptyStateCtaLabel && emptyStateCtaHref && (
        <a href={emptyStateCtaHref} class="blog-empty-cta">{props.emptyStateCtaLabel}</a>
      )}
    </div>

    {/* Pagination */}
    <div
      class={initialPosts.length > 0 ? "mt-8 md:mt-12 flex flex-col items-center justify-center gap-2 sm:gap-4" : "hidden"}
    >
      <button
        id="prevBtn"
        class="w-full sm:w-auto rounded-lg border border-slate-300 px-4 py-2 text-xs sm:text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed"
        disabled
      >
        ← Previous
      </button>
      <div id="pageNumbers" class="flex gap-1 flex-wrap justify-center">
        {
          Array.from({ length: initialTotalPages }, (_, i) => i + 1).map(
            (pageNum) => (
              <button
                class={`px-3 py-1 rounded-lg text-sm font-medium ${pageNum === 1 ? "blog-page-current" : "border border-slate-300 text-slate-700 hover:bg-slate-50"}`}
                disabled={pageNum === 1}
              >
                {pageNum}
              </button>
            ),
          )
        }
      </div>
      <button
        id="nextBtn"
        class="w-full sm:w-auto rounded-lg border border-slate-300 px-4 py-2 text-xs sm:text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed"
        disabled={initialTotalPages <= 1}
      >
        Next →
      </button>
    </div>

  </div>
  </div>
</section>

<style>
  .blog-list-section { width: 100%; padding-block: 64px; background: rgba(248, 250, 252, .5); }
  .blog-list-inner { width: min(calc(100% - 2 * var(--site-gutter)), var(--site-content-width)); min-width: 0; margin-inline: auto; }
  .blog-list-title { margin: 0 0 12px; color: #0f172a; font: 800 clamp(30px, 3.2vw, 40px)/1.15 var(--font-heading); letter-spacing: -.025em; }
  .blog-list-description { max-width: 672px; margin: 0 0 32px; color: #475569; font: 400 clamp(16px, 1.5vw, 18px)/1.6 var(--font-body); }
  .blog-category-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }
  .blog-category-chip { min-height: 44px; padding: 10px 24px; border: 1px solid var(--purple-soft); border-radius: 999px; background: transparent; color: var(--purple-hover); font: 700 14px/1.3 var(--font-heading); cursor: pointer; transition: background-color 200ms ease-out, color 200ms ease-out, box-shadow 200ms ease-out; }
  .blog-category-chip:hover { background: var(--purple-soft); }
  .blog-category-chip[aria-pressed="true"] { background: var(--purple-primary); border-color: var(--purple-primary); color: var(--button-text); font-weight: 700; box-shadow: var(--button-shadow-sm); opacity: 1; filter: none; text-shadow: none; }
  .blog-category-chip[aria-pressed="true"]:is(:hover, :focus-visible) { background: var(--purple-hover); border-color: var(--purple-hover); color: #fff; }
  .blog-category-chip:focus-visible { outline: 3px solid var(--purple-primary); outline-offset: 3px; }
  .blog-list-section :global(.blog-post-category) { display: inline-block; padding: 4px 12px; border-radius: 999px; background: var(--purple-primary); color: var(--button-text); font-size: 12px; font-weight: 700; }
  .blog-list-section :global(.blog-page-current) { background: var(--purple-primary); color: var(--button-text); font-weight: 700; }
  .blog-empty-state { max-width: 896px; margin: 24px auto; padding: 40px; border: 1px solid #e2e8f0cc; border-radius: 24px; background: #fff; box-shadow: 0 10px 15px -3px rgba(15, 23, 42, .1), 0 4px 6px -4px rgba(15, 23, 42, .1); text-align: center; }
  .blog-empty-icon { display: grid; place-items: center; width: 64px; height: 64px; margin: 0 auto 20px; border-radius: 16px; background: var(--purple-soft); color: var(--purple-primary); }
  .blog-empty-title { margin: 0 0 8px; color: #0f172a; font: 700 20px/1.3 var(--font-heading); }
  .blog-empty-description { max-width: 448px; margin: 0 auto 32px; color: #475569; font: 400 16px/1.65 var(--font-body); }
  .blog-empty-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; max-width: 100%; padding: 14px 32px; border-radius: 999px; background: var(--purple-primary); color: var(--button-text); font: 700 14px/1.35 var(--font-heading); text-decoration: none; box-shadow: var(--button-shadow-md); opacity: 1; filter: none; text-shadow: none; transition: transform 200ms ease-out, background-color 200ms ease-out, box-shadow 200ms ease-out; }
  .blog-empty-cta:is(:hover, :focus-visible) { transform: translateY(-2px); background: var(--purple-hover); color: var(--button-text); box-shadow: 0 20px 25px -5px rgba(15, 23, 42, .1), 0 8px 10px -6px rgba(15, 23, 42, .1); }
  .blog-empty-cta:focus-visible { outline: 3px solid var(--purple-primary); outline-offset: 4px; }
  .blog-empty-cta:active { transform: scale(.95); }
  @media (min-width: 1024px) { .blog-list-section { padding-block: 96px; } .blog-empty-state { padding: 64px; } .blog-empty-cta { font-size: 16px; } }
  @media (max-width: 400px) { .blog-empty-state { padding: 40px 24px; } .blog-empty-cta { padding-inline: 24px; } }
  @media (prefers-reduced-motion: reduce) { .blog-category-chip, .blog-empty-cta { transition: none; } .blog-empty-cta:is(:hover, :focus-visible, :active) { transform: none; } }
  /* Unified highlight — red italic, matches hero. */
  .bbg-blog-leaf {
    display: inline-block;
    color: var(--emergency);
    font-style: italic;
    padding-right: 0.05em;
  }
</style>

<script
  is:inline
  define:vars={{
    posts: JSON.stringify(allPosts),
  }}
>
  const normalizeSlug = (slug) =>
    typeof slug === "string" ? slug : (slug?.current ?? "");
  const allPosts = JSON.parse(posts)
    .map((p) => ({ ...p, slug: normalizeSlug(p.slug) }))
    .filter((p) => Boolean(p.slug));
  const blogSection = document.querySelector('[data-blog-list]');
  const defaultPostsPerPage = Math.max(1, Number(blogSection?.getAttribute('data-posts-per-page')) || 9);
  let postsPerPage = defaultPostsPerPage;
  let currentPage = 1;
  let filteredPosts = [...allPosts];
  // Sort by latest initially to match server render
  filteredPosts.sort(
    (a, b) => new Date(b.publishedAt) - new Date(a.publishedAt),
  );
  const postImageSizes =
    "(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw";

  const categoryFilter = document.getElementById("categoryFilter");
  const sortFilter = document.getElementById("sortFilter");
  const dateFromFilter = document.getElementById("dateFromFilter");
  const dateToFilter = document.getElementById("dateToFilter");
  const perPageFilter = document.getElementById("perPageFilter");
  const resetFiltersBtn = document.getElementById("resetFilters");
  const postsContainer = document.getElementById("postsContainer");
  const noResults = document.getElementById("noResults");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const pageNumbers = document.getElementById("pageNumbers");

  // Populate categories
  const categories = [
    ...new Set(
      allPosts.flatMap((p) =>
        Array.isArray(p.categories) ? p.categories.filter(Boolean) : [],
      ),
    ),
  ];
  categories.forEach((cat) => {
    const option = document.createElement("option");
    option.value = cat;
    option.textContent = cat;
    categoryFilter.appendChild(option);
  });
  categoryFilter.value = blogSection?.getAttribute('data-filter-category') || '';
  const categoryChips = document.querySelectorAll('[data-category-chip]');
  categoryChips.forEach((chip) => chip.addEventListener('click', () => {
    categoryFilter.value = chip.dataset.categoryChip || '';
    filterAndSort();
  }));

  function renderPosts(posts) {
    postsContainer.innerHTML = "";

    if (posts.length === 0) {
      postsContainer.classList.add("hidden");
      noResults.classList.remove("hidden");
      updatePagination(0);
      return;
    }

    postsContainer.classList.remove("hidden");
    noResults.classList.add("hidden");

    const startIdx = (currentPage - 1) * postsPerPage;
    const endIdx = startIdx + postsPerPage;
    const paginatedPosts = posts.slice(startIdx, endIdx);

    paginatedPosts.forEach((post) => {
      const slug = normalizeSlug(post.slug);
      if (!slug) return;

      const article = document.createElement("article");
      article.className =
        "group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 cursor-pointer";

      const imageHTML = post.optimizedImage
        ? `<div class="relative aspect-[2/1] w-full overflow-hidden bg-slate-100">
             <img src="${post.optimizedImage}" srcset="${post.optimizedImageSrcSet ?? ""}" sizes="${postImageSizes}" alt="${post.featuredImage?.alt || post.title}" width="1000" height="500" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110" loading="lazy" decoding="async" />
           </div>`
        : "";

      const categoryHTML =
        post.categories && post.categories.length > 0
          ? post.categories
              .map(
                (category) =>
                  `<span class="blog-post-category">${category}</span>`,
              )
              .join("")
          : "";

      const dateHTML = post.publishedAt
        ? `<span class="text-xs text-slate-500">${new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span>`
        : "";

      const tagsHTML =
        post.tags && post.tags.length > 0
          ? `<div class="mb-4 flex flex-wrap gap-2">
             ${post.tags
               .slice(0, 3)
               .map(
                 (tag) => `<span class="text-xs text-slate-500">#${tag}</span>`,
               )
               .join("")}
           </div>`
          : "";

      article.innerHTML = `
        ${imageHTML}
        <div class="p-6">
          <div class="mb-2 flex items-center gap-2">
            ${categoryHTML}
            ${dateHTML}
          </div>
          <h3 class="mb-2 text-xl font-semibold text-slate-900 line-clamp-2">
            <a href="/blog/${slug}/" class="hover:text-[--green-primary]">
              ${post.title}
            </a>
          </h3>
          <p class="mb-4 text-slate-600 line-clamp-2">${post.excerpt || "Read more about this post..."}</p>
          ${tagsHTML}
          <a href="/blog/${slug}/" class="btn-primary inline-flex">
            Read More
          </a>
        </div>
      `;

      // Make the entire card clickable
      article.addEventListener("click", () => {
        window.location.href = `/blog/${slug}/`;
      });

      postsContainer.appendChild(article);
    });

    updatePagination(posts.length);
  }

  function updatePagination(totalPosts) {
    const totalPages = Math.ceil(totalPosts / postsPerPage);
    pageNumbers.innerHTML = "";

    prevBtn.disabled = currentPage === 1 || totalPages === 0;
    nextBtn.disabled = currentPage === totalPages || totalPages === 0;

    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement("button");
      btn.className = `px-3 py-1 rounded-lg text-sm font-medium ${
        i === currentPage
          ? "blog-page-current"
          : "border border-slate-300 text-slate-700 hover:bg-slate-50"
      }`;
      btn.textContent = i;
      btn.disabled = i === currentPage;
      btn.addEventListener("click", () => {
        currentPage = i;
        renderPosts(filteredPosts);
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
      pageNumbers.appendChild(btn);
    }
  }

  function filterAndSort() {
    let filtered = [...allPosts];
    categoryChips.forEach((chip) => chip.setAttribute('aria-pressed', String((chip.dataset.categoryChip || '') === categoryFilter.value)));

    // Filter by category
    if (categoryFilter.value) {
      filtered = filtered.filter(
        (p) =>
          Array.isArray(p.categories) &&
          p.categories.includes(categoryFilter.value),
      );
    }

    // Filter by date range
    if (dateFromFilter.value) {
      const fromDate = new Date(dateFromFilter.value);
      filtered = filtered.filter((p) => new Date(p.publishedAt) >= fromDate);
    }

    if (dateToFilter.value) {
      const toDate = new Date(dateToFilter.value);
      toDate.setHours(23, 59, 59, 999);
      filtered = filtered.filter((p) => new Date(p.publishedAt) <= toDate);
    }

    // Sort
    const sortValue = sortFilter.value;
    if (sortValue === "latest") {
      filtered.sort(
        (a, b) => new Date(b.publishedAt) - new Date(a.publishedAt),
      );
    } else if (sortValue === "oldest") {
      filtered.sort(
        (a, b) => new Date(a.publishedAt) - new Date(b.publishedAt),
      );
    } else if (sortValue === "title-asc") {
      filtered.sort((a, b) => a.title.localeCompare(b.title));
    } else if (sortValue === "title-desc") {
      filtered.sort((a, b) => b.title.localeCompare(a.title));
    }

    filteredPosts = filtered;
    currentPage = 1;
    renderPosts(filtered);
  }

  // Event listeners
  categoryFilter.addEventListener("change", filterAndSort);
  sortFilter.addEventListener("change", filterAndSort);
  dateFromFilter.addEventListener("change", filterAndSort);
  dateToFilter.addEventListener("change", filterAndSort);

  resetFiltersBtn.addEventListener("click", () => {
    categoryFilter.value = "";
    sortFilter.value = "latest";
    dateFromFilter.value = "";
    dateToFilter.value = "";
    if (perPageFilter) {
      const resetValue =
        defaultPostsPerPage >= allPosts.length
          ? "all"
          : String(defaultPostsPerPage);
      perPageFilter.value = resetValue;
      postsPerPage =
        resetValue === "all" ? allPosts.length : defaultPostsPerPage;
    } else {
      postsPerPage = defaultPostsPerPage;
    }
    currentPage = 1;
    filterAndSort();
  });

  prevBtn.addEventListener("click", () => {
    if (currentPage > 1) {
      currentPage--;
      renderPosts(filteredPosts);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  nextBtn.addEventListener("click", () => {
    const totalPages = Math.ceil(filteredPosts.length / postsPerPage);
    if (currentPage < totalPages) {
      currentPage++;
      renderPosts(filteredPosts);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  if (perPageFilter) {
    perPageFilter.addEventListener("change", (event) => {
      const value = event.target?.value;
      postsPerPage =
        value === "all" ? allPosts.length : Math.max(1, Number(value) || 9);
      currentPage = 1;
      renderPosts(filteredPosts);
    });
  }

  // Add event listeners to initial pagination buttons
  const initialPageButtons = pageNumbers.querySelectorAll("button");
  initialPageButtons.forEach((btn, index) => {
    btn.addEventListener("click", () => {
      currentPage = index + 1;
      renderPosts(filteredPosts);
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });

  // Initial render is NOT called to preserve server-rendered content
  // But we need to attach event listeners to the server-rendered elements if needed?
  // The server rendered elements have onclick attributes, so they work.
  // But pagination buttons need listeners.
  // I added listeners to initialPageButtons above.

  // However, if the user changes a filter, we MUST call filterAndSort.
  // And we need to ensure the state is consistent.
</script>
