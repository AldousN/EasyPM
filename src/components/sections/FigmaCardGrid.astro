---
import type { ProcessSection } from '../../types/sections';
import { portableTextToHtml } from '../../lib/portableText';
import { buildSanityImageUrl, optimizeImageUrl } from '../../lib/imageOptimizer';
import { splitHighlight, titleCaseHeading } from '../../utils/highlightTitle';

const section = Astro.props as ProcessSection;
const variant = section.visualVariant;
const isPhoto = variant === 'figmaPhotoCards';
const isBadge = variant === 'figmaBadgeCards';
const isProcess = variant === 'figmaIconCards';
const ListTag = isProcess ? 'ol' : 'ul';
const isDark = section.backgroundTheme === 'darkGreen';
const columns = section.columns ?? (isBadge ? 4 : 3);
const imageUrl = (image: NonNullable<ProcessSection['steps'][number]['image']>, width: number) => {
  const options = isPhoto
    ? { width, height: Math.round(width * 10 / 16), quality: 78, format: 'webp' as const, fit: 'crop' as const }
    : { width, quality: 78, format: 'webp' as const, fit: 'max' as const };
  return buildSanityImageUrl(image, options) ||
    optimizeImageUrl(image.url || image.asset?.url, options);
};
---

<section class:list={['figma-cards', { 'figma-cards-dark': isDark, 'figma-cards-badge': isBadge, 'figma-cards-photo': isPhoto, 'figma-cards-process': isProcess }]}>
  <div class="figma-cards-inner">
    {(section.title || section.subtitle) && <header class="figma-cards-heading">
      {isPhoto && <span class="figma-cards-eyebrow">EasyPM Difference</span>}
      {section.title && <h2>{splitHighlight(titleCaseHeading(section.title), section.highlightText).map((segment) => segment.highlight ? <span class="figma-cards-highlight">{segment.text}</span> : <span>{segment.text}</span>)}</h2>}
      {section.subtitle && <p>{section.subtitle}</p>}
    </header>}
    <ListTag class={`figma-cards-grid columns-${columns}`}>
      {section.steps.map((card, index) => {
        const image = card.image;
        const src = image ? imageUrl(image, isPhoto ? 700 : 280) : '';
        const supportsResponsiveImage = Boolean(image?.asset?._ref || image?.asset?._id || image?.asset?.url?.includes('cdn.sanity.io') || image?.url?.includes('cdn.sanity.io'));
        const title = card.label || card.title || '';
        return <li class="figma-card">
          {isProcess && <span class="figma-step-number" aria-label={`Step ${index + 1}`}>{String(index + 1).padStart(2, '0')}</span>}
          {src && !isBadge && <div class="figma-card-media"><img src={src} srcset={image && isPhoto && supportsResponsiveImage ? `${imageUrl(image, 400)} 400w, ${imageUrl(image, 800)} 800w, ${imageUrl(image, 1200)} 1200w` : undefined} sizes={isPhoto && supportsResponsiveImage ? '(max-width: 680px) calc(100vw - 40px), (max-width: 1200px) 32vw, 386px' : undefined} alt={image?.alt || title} width={isPhoto ? 800 : 280} height={isPhoto ? 500 : 280} loading="lazy" decoding="async" /></div>}
          <div class="figma-card-copy">
            <div class="figma-card-title-row">
              {src && isBadge && <img class="figma-card-inline-icon" src={src} alt="" width="36" height="36" loading="lazy" decoding="async" />}
              {!src && !isPhoto && <span class="figma-card-title-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg></span>}
              <h3>{titleCaseHeading(title)}</h3>
            </div>
            {card.description?.length ? <div class="figma-card-description" set:html={portableTextToHtml(card.description)} /> : null}
            {isPhoto && <span class="figma-card-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m14 5 7 7-7 7M21 12H3" /></svg></span>}
          </div>
        </li>;
      })}
    </ListTag>
  </div>
</section>

<style>
  .figma-card-title-row { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .figma-card-inline-icon { display: block; width: 36px; height: 36px; flex: none; object-fit: contain; }
  .figma-card-title-mark { display: inline-grid; width: 26px; height: 26px; flex: none; place-items: center; border-radius: 50%; background: var(--purple-hover); color: #fff; }
  .figma-card-title-mark svg { width: 16px; height: 16px; }
  .figma-cards { background: #f7f7f7; color: #252525; padding: clamp(56px, 6vw, 96px) var(--site-gutter); }
  .figma-cards-dark { background: #262626; color: #fff; }
  .figma-cards-badge { background: #e9e9e9; }
  .figma-cards-inner { width: min(100%, var(--site-content-width)); margin-inline: auto; }
  .figma-cards-highlight { color: var(--heading-highlight-color); text-decoration: none; border-bottom: 0; }
  .figma-cards-heading { max-width: 720px; margin: 0 auto 42px; text-align: center; }
  .figma-cards-heading h2 { margin: 0 0 10px; font: 700 clamp(28px, 3vw, 40px)/1.15 var(--font-heading); }
  .figma-cards-heading p { margin: 0; font: 400 clamp(15px, 1.25vw, 18px)/1.5 var(--font-body); }
  .figma-cards-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; }
  .figma-cards-process .figma-card { position: relative; padding: 28px 14px 16px; border: 1px solid var(--purple-soft); border-radius: 24px; }
  .figma-step-number { position: absolute; top: 20px; left: 20px; display: inline-grid; place-items: center; width: 42px; height: 42px; border: 1px solid var(--purple-primary); border-radius: 50%; background: var(--purple-primary); color: var(--button-text); font: 700 14px/1 var(--font-heading); }
  .figma-cards-process .figma-card-media { margin-top: 22px; }
  .figma-cards-process .figma-card-title-mark { display: none; }
  .figma-cards-grid.columns-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .figma-card { min-width: 0; overflow: hidden; border: 1px solid #e5e7eb; border-radius: 16px; background: #fff; color: #171717; box-shadow: 0 3px 10px #0002; transition: transform 300ms ease-out, box-shadow 300ms ease-out; }
  .figma-card:is(:hover, :focus-within) { transform: translateY(-4px); box-shadow: 0 16px 32px #0003; }
  .figma-card-media { display: grid; place-items: center; min-height: 132px; padding: 18px 18px 0; }
  .figma-card-media img { display: block; width: 112px; height: 112px; object-fit: contain; }
  .figma-cards-photo { position: relative; isolation: isolate; padding-block: 72px; background: var(--surface-white); }
  .figma-cards-photo::before { position: absolute; z-index: -1; inset: 0; background: none; content: ''; pointer-events: none; }
  .figma-cards-photo.figma-cards-dark { background: #262626; }
  .figma-cards-photo.figma-cards-dark::before { background: none; }
  .figma-cards-photo .figma-cards-heading { max-width: 640px; margin-bottom: 48px; }
  .figma-cards-eyebrow { display: inline-block; margin-bottom: 14px; padding: 4px 14px; border-radius: 999px; background: var(--purple-primary); color: var(--button-text); font: 700 12px/1.2 var(--font-body); letter-spacing: .11em; text-transform: uppercase; }
  .figma-cards-photo .figma-cards-heading h2 { margin-bottom: 12px; color: #111827; font-size: clamp(30px, 3vw, 40px); font-weight: 800; letter-spacing: -.035em; }
  .figma-cards-photo .figma-cards-heading p { color: #4b5563; font-size: clamp(16px, 1.3vw, 18px); }
  .figma-cards-photo .figma-card { display: flex; flex-direction: column; border-color: #e7e2f0; border-radius: 24px; box-shadow: 0 12px 30px rgba(15, 23, 42, 0.125); transition: transform 300ms ease-out, box-shadow 300ms ease-out, border-color 300ms ease-out; }
  .figma-cards-photo .figma-card:is(:hover, :focus-within) { transform: translateY(-8px); border-color: var(--purple-soft); box-shadow: 0 24px 48px rgba(15, 23, 42, 0.200); }
  .figma-cards-photo .figma-card-media { position: relative; display: block; min-height: 0; padding: 0; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 23px 23px 0 0; }
  .figma-cards-photo .figma-card-media::after { position: absolute; inset: 0; background: linear-gradient(0deg, #09071391 0%, #0907131a 48%, transparent 78%); content: ''; pointer-events: none; }
  .figma-cards-photo .figma-card-media img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: center; border-radius: 23px 23px 0 0; transition: transform 500ms ease-out; }
  .figma-cards-photo .figma-card:is(:hover, :focus-within) .figma-card-media img { transform: scale(1.05); }
  .figma-card-copy { padding: 18px 20px 24px; text-align: center; }
  .figma-cards-photo .figma-card-copy { display: flex; min-height: 112px; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 20px; border-top: 1px solid #f1f5f9; border-radius: 0 0 23px 23px; background: #f8fafc; color: #0f172a; text-align: center; }
  .figma-card h3 { margin: 0 0 9px; font: 700 clamp(17px, 1.55vw, 21px)/1.18 var(--font-heading); }
  .figma-cards-photo .figma-card h3 { margin: 0; color: #0f172a; font-weight: 700; font-size: 14px; letter-spacing: .08em; line-height: 1.2; text-transform: uppercase; }
  .figma-cards-photo .figma-card-arrow { display: grid; width: 32px; height: 32px; flex: none; place-items: center; border-radius: 50%; background: #7c3aed; color: #fff; box-shadow: var(--button-shadow-sm); transition: transform 200ms ease-out; }
  .figma-cards-photo .figma-card-arrow svg { width: 16px; height: 16px; }
  .figma-cards-photo .figma-card:is(:hover, :focus-within) .figma-card-arrow { transform: translateX(4px); }
  .figma-cards-photo .figma-card-description { color: #475569; text-transform: none; }
  .figma-cards-dark .figma-cards-heading h2 { color: #fff; }
  .figma-cards-dark .figma-cards-highlight { color: var(--purple-highlight-dark); text-decoration: none; border-bottom: 0; }
  .figma-cards-dark .figma-cards-heading p { color: #e5e5e5; }
  .figma-card-description { font: 400 14px/1.45 var(--font-body); }
  .figma-card-description :global(p) { margin: 0; }
  @media (prefers-reduced-motion: reduce) {
    .figma-card { transition: none; }
    .figma-card:is(:hover, :focus-within) { transform: none; }
    .figma-cards-photo .figma-card:is(:hover, :focus-within) { transform: none; }
    .figma-cards-photo .figma-card-media img { transition: none; }
    .figma-cards-photo .figma-card:is(:hover, :focus-within) .figma-card-media img { transform: none; }
    .figma-cards-photo .figma-card-arrow { transition: none; }
    .figma-cards-photo .figma-card:is(:hover, :focus-within) .figma-card-arrow { transform: none; }
  }
  @media (min-width: 1024px) {
    .figma-cards-photo { padding-block: 96px; }
    .figma-cards-photo .figma-cards-heading { margin-bottom: 56px; }
    .figma-cards-photo .figma-card-copy { padding: 24px; }
    .figma-cards-photo .figma-card h3 { font-size: 16px; }
  }
  @media (max-width: 900px) { .figma-cards-grid.columns-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) {
    .figma-cards { padding-inline: var(--site-gutter); }
    .figma-cards-grid, .figma-cards-grid.columns-4 { grid-template-columns: 1fr; }
    .figma-cards-badge .figma-card { max-width: 420px; width: 100%; margin-inline: auto; }
  }
</style>
